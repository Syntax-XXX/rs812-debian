auto lo
iface lo inet loopback

# port 1 – home network (as under DSM)
auto eth0
iface eth0 inet static
    hwaddress ether 00:11:32:1f:8e:b9
    address 10.40.32.63/24
    gateway 10.40.32.1

# port 2 – direct link to pve2 (as under DSM)
auto eth1
iface eth1 inet static
    hwaddress ether 00:11:32:1f:8e:ba
    address 192.168.50.1/24

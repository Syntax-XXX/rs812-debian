+++ b/src/components/rs812/AdminPanel.vue
@@ -0,0 +1,247 @@
+<template>
+	<div class="modal-card rs812-admin">
+		<header class="modal-card-head">
+			<div class="is-flex-grow-1">
+				<h3 class="title is-header">Verwaltung · {{ ov.hostname || 'RackStation' }}</h3>
+			</div>
+			<b-icon class="close-button" icon="close-outline" pack="casa" @click.native="$emit('close')" />
+		</header>
+		<section class="modal-card-body">
+			<b-tabs v-model="tab" :animated="false" @input="onTab">
+				<!-- Übersicht -->
+				<b-tab-item label="Übersicht" class="scrollbars-light-auto tab-item">
+					<div class="columns is-multiline">
+						<div class="column is-half" v-for="c in cards" :key="c.k">
+							<div class="tile-box">
+								<p class="tile-label">{{ c.k }}</p>
+								<p class="tile-value">{{ c.v }}</p>
+								<p class="tile-sub" v-if="c.s">{{ c.s }}</p>
+							</div>
+						</div>
+					</div>
+					<h4 class="sub-head">Energie</h4>
+					<div class="buttons">
+						<b-button rounded size="is-small" type="is-primary" @click="power('reboot')">Neu starten</b-button>
+						<b-button rounded size="is-small" type="is-danger" @click="power('poweroff')">Herunterfahren</b-button>
+					</div>
+				</b-tab-item>
+
+				<!-- Platten & RAID -->
+				<b-tab-item label="Platten & RAID" class="scrollbars-light-auto tab-item">
+					<div v-for="d in ov.disks || []" :key="d.name" class="row-box">
+						<div class="is-flex is-align-items-center">
+							<span class="disk-emoji mr-3">💽</span>
+							<div class="is-flex-grow-1">
+								<p class="has-text-weight-semibold">{{ d.name }} · {{ d.model }}</p>
+								<p class="is-size-7 has-text-grey">
+									{{ size(d.size) }} · {{ d.standby ? 'schläft' : (d.temperature + ' °C') }} · {{ d.power_on_hours }} h
+									· SN {{ d.serial || '–' }}
+									<span v-if="d.reallocated || d.pending" class="has-text-danger"> · {{ d.reallocated }} ersetzte / {{ d.pending }} wartende Sektoren</span>
+								</p>
+							</div>
+							<b-tag :type="d.health ? 'is-success' : 'is-danger'" rounded>{{ d.health ? 'Gesund' : 'Prüfen!' }}</b-tag>
+							<b-button class="ml-2" rounded size="is-small" @click="smart(d.name)">SMART</b-button>
+						</div>
+					</div>
+					<h4 class="sub-head">RAID</h4>
+					<div v-for="m in ov.raid || []" :key="m.name" class="row-box">
+						<p class="has-text-weight-semibold">{{ m.name }} · {{ m.level }} · {{ m.mount || '–' }}</p>
+						<p class="is-size-7 has-text-grey">{{ m.members.join(', ') }} · {{ m.status }} <span v-if="m.sync" class="has-text-warning">· {{ m.sync }}</span></p>
+					</div>
+					<pre v-if="smartText" class="log-box">{{ smartText }}</pre>
+				</b-tab-item>
+
+				<!-- Freigaben -->
+				<b-tab-item label="Freigaben (NFS)" class="scrollbars-light-auto tab-item">
+					<p class="is-size-7 has-text-grey mb-2">Inhalt von <code>/etc/exports</code>. Beim Speichern wird geprüft; bei einem Fehler bleiben die alten Freigaben aktiv.</p>
+					<b-input v-model="exportsText" type="textarea" custom-class="mono" rows="9" />
+					<div class="buttons mt-3">
+						<b-button rounded size="is-small" type="is-primary" :loading="busy" @click="saveExports">Speichern &amp; anwenden</b-button>
+					</div>
+					<h4 class="sub-head">Aktiv</h4>
+					<pre class="log-box">{{ exportsActive }}</pre>
+				</b-tab-item>
+
+				<!-- Dienste -->
+				<b-tab-item label="Dienste" class="scrollbars-light-auto tab-item">
+					<div v-for="s in services" :key="s.name" class="row-box is-flex is-align-items-center">
+						<span class="dot" :class="s.ActiveState === 'active' ? 'on' : 'off'"></span>
+						<div class="is-flex-grow-1">
+							<p class="has-text-weight-semibold">{{ s.Description || s.name }}</p>
+							<p class="is-size-7 has-text-grey">{{ s.name }} · {{ s.ActiveState }} ({{ s.SubState }}) · Autostart: {{ s.UnitFileState }}</p>
+						</div>
+						<div class="buttons">
+							<b-button rounded size="is-small" @click="svc(s.name, 'restart')">Neustart</b-button>
+							<b-button v-if="s.ActiveState === 'active'" rounded size="is-small" @click="svc(s.name, 'stop')">Stopp</b-button>
+							<b-button v-else rounded size="is-small" type="is-primary" @click="svc(s.name, 'start')">Start</b-button>
+							<b-button rounded size="is-small" @click="showLogs(s.name)">Log</b-button>
+						</div>
+					</div>
+				</b-tab-item>
+
+				<!-- Updates & Pakete -->
+				<b-tab-item label="Updates" class="scrollbars-light-auto tab-item">
+					<div class="buttons">
+						<b-button rounded size="is-small" :loading="busy" @click="checkUpdates">Nach Updates suchen</b-button>
+						<b-button rounded size="is-small" type="is-primary" :disabled="!updates.length || jobRunning" @click="installUpdates">{{ updates.length }} Updates installieren</b-button>
+					</div>
+					<ul class="is-size-7 mb-3"><li v-for="u in updates" :key="u">{{ u }}</li></ul>
+					<b-field label="Paket installieren (apt)">
+						<b-input v-model="pkg" placeholder="z. B. htop samba" size="is-small" />
+						<p class="control"><b-button size="is-small" :disabled="!pkg || jobRunning" @click="installPkg">Installieren</b-button></p>
+					</b-field>
+					<pre v-if="jobOut" class="log-box">{{ jobOut }}</pre>
+				</b-tab-item>
+
+				<!-- Protokolle -->
+				<b-tab-item label="Protokolle" class="scrollbars-light-auto tab-item">
+					<div class="buttons">
+						<b-button rounded size="is-small" @click="showLogs('')">System</b-button>
+						<b-button rounded size="is-small" @click="showLogs('', true)">Kernel</b-button>
+						<b-button rounded size="is-small" @click="showLogs('nfs-server.service')">NFS</b-button>
+						<b-button rounded size="is-small" @click="showLogs('rs812-fan.service')">Lüfter</b-button>
+					</div>
+					<pre class="log-box tall">{{ logText }}</pre>
+				</b-tab-item>
+			</b-tabs>
+		</section>
+	</div>
+</template>
+
+<script>
+import { api } from '@/service/service.js'
+
+export default {
+	name: 'rs812-admin-panel',
+	data () {
+		return {
+			tab: 0, ov: {}, timer: null, busy: false, smartText: '',
+			exportsText: '', exportsActive: '', services: [], updates: [],
+			pkg: '', jobId: '', jobOut: '', jobRunning: false, logText: ''
+		}
+	},
+	computed: {
+		cards () {
+			const o = this.ov
+			if (!o.mem) return []
+			const up = o.uptime || 0
+			const fan = o.fan || {}
+			const temps = (o.disks || []).filter(d => !d.standby && d.temperature).map(d => d.temperature)
+			return [
+				{ k: 'Laufzeit', v: `${Math.floor(up / 86400)} T ${Math.floor(up % 86400 / 3600)} h ${Math.floor(up % 3600 / 60)} min`, s: 'Last ' + o.load },
+				{ k: 'Arbeitsspeicher', v: `${this.size(o.mem.used)} / ${this.size(o.mem.total)}`, s: `Swap frei ${this.size(o.mem.swapFree)}` },
+				{ k: 'Lüfter', v: fan.rpm ? `${fan.rpm} U/min` : '–', s: fan.pwm !== undefined ? `Stufe ${Math.round(fan.pwm / 255 * 100)} %` : '' },
+				{ k: 'Plattentemperatur', v: temps.length ? Math.max(...temps) + ' °C' : 'alle schlafen', s: temps.length ? `min ${Math.min(...temps)} °C` : '' },
+				...(o.volumes || []).map(v => ({ k: v.path, v: `${this.size(v.used)} / ${this.size(v.size)}`, s: `${v.dev} · frei ${this.size(v.avail)}` })),
+				...(o.net || []).map(n => ({ k: n.name, v: n.state === 'up' ? 'verbunden' : n.state, s: `↑ ${this.size(n.bytesSent)} · ↓ ${this.size(n.bytesRecv)}` }))
+			]
+		}
+	},
+	mounted () {
+		this.loadOverview()
+		this.timer = setInterval(() => { if (this.tab === 0 || this.tab === 1) this.loadOverview() }, 5000)
+	},
+	beforeDestroy () { clearInterval(this.timer) },
+	methods: {
+		size (b) {
+			if (!b) return '0 B'
+			const u = ['B', 'KB', 'MB', 'GB', 'TB']
+			let i = 0
+			while (b >= 1024 && i < u.length - 1) { b /= 1024; i++ }
+			return `${b.toFixed(i > 1 ? 1 : 0)} ${u[i]}`
+		},
+		toast (msg, type = 'is-success') { this.$buefy.toast.open({ message: msg, type }) },
+		async call (fn) {
+			try {
+				const r = await fn()
+				if (r.data.success !== 200) { this.toast(r.data.message || 'Fehler', 'is-danger'); return null }
+				return r.data.data
+			} catch (e) {
+				this.toast(e.response?.data?.message || e.message, 'is-danger')
+				return null
+			}
+		},
+		async loadOverview () { const d = await this.call(() => api.get('/rs812/overview')); if (d) this.ov = d },
+		onTab (t) {
+			if (t === 2) this.loadExports()
+			if (t === 3) this.loadServices()
+			if (t === 5 && !this.logText) this.showLogs('')
+		},
+		async smart (dev) { this.smartText = 'Lese SMART …'; this.smartText = await this.call(() => api.get('/rs812/smart/' + dev)) || '' },
+		async loadExports () {
+			const d = await this.call(() => api.get('/rs812/exports'))
+			if (d) { this.exportsText = d.content; this.exportsActive = d.active }
+		},
+		async saveExports () {
+			this.busy = true
+			const d = await this.call(() => api.put('/rs812/exports', { content: this.exportsText }))
+			this.busy = false
+			if (d) { this.toast('Freigaben übernommen'); this.loadExports() }
+		},
+		async loadServices () { this.services = await this.call(() => api.get('/rs812/services')) || [] },
+		async svc (name, action) {
+			const d = await this.call(() => api.post(`/rs812/services/${name}/${action}`))
+			if (d) { this.toast(`${name}: ${action} ok`); setTimeout(this.loadServices, 800) }
+		},
+		async checkUpdates () {
+			this.busy = true
+			this.updates = await this.call(() => api.post('/rs812/updates/check')) || []
+			this.busy = false
+			if (!this.updates.length) this.toast('Alles aktuell')
+		},
+		async followJob (id) {
+			this.jobId = id
+			this.jobRunning = true
+			const tick = async () => {
+				const j = await this.call(() => api.get('/rs812/jobs/' + id))
+				if (!j) { this.jobRunning = false; return }
+				this.jobOut = j.output
+				if (j.running) setTimeout(tick, 1500)
+				else {
+					this.jobRunning = false
+					this.toast(j.exit_code === 0 ? `${j.title}: fertig` : `${j.title}: Fehler (${j.exit_code})`, j.exit_code === 0 ? 'is-success' : 'is-danger')
+				}
+			}
+			tick()
+		},
+		async installUpdates () { const id = await this.call(() => api.post('/rs812/updates/install')); if (id) { this.updates = []; this.followJob(id) } },
+		async installPkg () { const id = await this.call(() => api.post('/rs812/apt/install', { packages: this.pkg })); if (id) this.followJob(id) },
+		async showLogs (unit, kernel) {
+			this.tab = 5
+			this.logText = 'Lade …'
+			const q = []
+			if (unit) q.push('unit=' + encodeURIComponent(unit))
+			if (kernel) q.push('kernel=1')
+			this.logText = await this.call(() => api.get('/rs812/logs' + (q.length ? '?' + q.join('&') : ''))) || ''
+		},
+		power (action) {
+			this.$buefy.dialog.confirm({
+				title: action === 'reboot' ? 'Neu starten?' : 'Herunterfahren?',
+				message: action === 'reboot' ? 'Die NAS startet neu (ca. 2–4 Minuten). Freigaben sind so lange weg.' : 'Die NAS schaltet sich aus. Einschalten nur am Gerät.',
+				confirmText: action === 'reboot' ? 'Neu starten' : 'Herunterfahren',
+				cancelText: 'Abbrechen',
+				type: action === 'reboot' ? 'is-primary' : 'is-danger',
+				onConfirm: async () => { if (await this.call(() => api.post('/rs812/power/' + action))) this.toast('Wird ausgeführt …', 'is-warning') }
+			})
+		}
+	}
+}
+</script>
+
+<style lang="scss" scoped>
+.rs812-admin {
+	width: min(960px, 96vw);
+	.modal-card-body { max-height: 78vh; overflow-y: auto; }
+	.tab-item { padding-top: 0.75rem; }
+	.tile-box { background: hsla(208, 16%, 94%, 1); border-radius: 0.75rem; padding: 0.875rem 1rem; }
+	.tile-label { font-size: 0.75rem; color: #7a8a99; }
+	.tile-value { font-size: 1.25rem; font-weight: 600; color: #22313f; }
+	.tile-sub { font-size: 0.75rem; color: #8a99a8; }
+	.row-box { background: hsla(208, 16%, 96%, 1); border-radius: 0.75rem; padding: 0.75rem 1rem; margin-bottom: 0.5rem; }
+	.sub-head { font-weight: 600; margin: 1.25rem 0 0.5rem; }
+	.log-box { background: #101820; color: #d6e2ee; border-radius: 0.5rem; padding: 0.75rem; font-size: 0.75rem; max-height: 40vh; overflow: auto; white-space: pre-wrap; }
+	.log-box.tall { max-height: 58vh; }
+	.dot { width: 10px; height: 10px; border-radius: 50%; margin-right: 0.75rem; &.on { background: #2ecc71; } &.off { background: #c0c8d0; } }
+	::v-deep .mono { font-family: ui-monospace, Menlo, monospace; font-size: 0.8rem; }
+}
+</style>
